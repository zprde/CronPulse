/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cron-pulse",
	"main": "worker/index.ts",
	"compatibility_date": "2025-12-02",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	/**
	 * KV Namespace for storing job data
	 * Create with: wrangler kv:namespace create "CRONPULSE_KV"
	 */
	"kv_namespaces": [
		{
			"binding": "CRONPULSE_KV",
			"id": "39546c8a2ea1417f8f90b8fb29a77bf4",
			"preview_id": "e552ef4695a34367804836d05cfa874d"
		}
	],
	/**
	 * Cron Triggers for scheduled alert checking
	 * Runs every 5 minutes to check for missed heartbeats
	 */
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	/**
	 * Environment Variables and Secrets
	 * 
	 * Authentication (set via wrangler secret put):
	 * - ADMIN_PASSWORD: Admin password for dashboard access
	 *   npx wrangler secret put ADMIN_PASSWORD
	 * 
	 * Telegram Bot (set via wrangler secret put):
	 * - TELEGRAM_BOT_TOKEN: Telegram bot API token
	 *   npx wrangler secret put TELEGRAM_BOT_TOKEN
	 * - TELEGRAM_CHAT_ID: Your Telegram chat ID for alerts
	 *   npx wrangler secret put TELEGRAM_CHAT_ID
	 */
	"vars": {
		"MAX_HISTORY_RECORDS": 50
	}
}